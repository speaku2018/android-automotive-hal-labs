package {
    default_applicable_licenses: ["hardware_interfaces_license"],
}

aidl_interface {
    name: "android.hardware.helloworld",
    vendor_available: true,
    srcs: ["android/hardware/helloworld/*.aidl"],
    stability: "vintf",
    backend: {
        ndk: { enabled: true },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    frozen: false,
}
