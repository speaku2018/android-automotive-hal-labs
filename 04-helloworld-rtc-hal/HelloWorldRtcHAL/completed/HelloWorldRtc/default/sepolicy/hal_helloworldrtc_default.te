type hal_helloworldrtc_default, domain;
type hal_helloworldrtc_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_helloworldrtc_default)
hal_server_domain(hal_helloworldrtc_default, hal_helloworldrtc)
binder_use(hal_helloworldrtc_default)

# Existing system:system DAC permissions permit the service's read-only open.
# Keep RTC_SET_TIME and alarm operations outside this interface.
allow hal_helloworldrtc_default rtc_device:chr_file { getattr open read ioctl };
allowxperm hal_helloworldrtc_default rtc_device:chr_file ioctl { 0x7009 };
