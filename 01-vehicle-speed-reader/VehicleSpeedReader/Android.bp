android_app {
    name: "VehicleSpeedReader",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    libs: ["android.car"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
}

prebuilt_etc {
    name: "privapp-permissions-vehiclespeedreader",
    src: "permissions/privapp-permissions-com.example.vehiclespeedreader.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}
